+/*
+ * surya (POCO X3 NFC) LCD backlight: PM6150L WLED5 (SID 5, ctrl 0xd800,
+ * sink 0xd900), driven through sweet_spmi_write() (patch 0083).
+ *
+ * Off unless boot-arg sweetbl=1 (or 2 = also dim to ~11% for 2 s at start as
+ * a visible self-test). Registers follow Linux qcom-wled.c (WLED5):
+ *   ctrl  0x46 bit 7     module enable (display off = 0, on = restore)
+ *   sink  0x50 / 0x60    MOD_A / MOD_B enable (bit 7), read only here
+ *   sink  0x52 / 0x62    brightness width (1 = 15 bit, 0 = 12 bit)
+ *   sink  0x53+0x54 / 0x63+0x64   brightness LSB/MSB of MOD_A / MOD_B
+ *   sink  0x65 bits 1:0  sync: clear, then set the module's bit
+ * The module ABL left enabled and its current level are read at start;
+ * nothing is written before iOS asks (or the self-test).
+ *
+ * iOS side: backboardd looks for an IOService with property
+ * backlight-control = true. This service publishes it plus
+ * IODisplayParameters/brightness {min 0, max 65536, value} and logs every
+ * setProperties() and newUserClient() call as "SWEET BL: ..." so the real
+ * protocol can be read from the log. Brightness values found under
+ * IODisplayParameters.brightness(.value) or brightness(.value) are applied
+ * (perceptual square curve, floor 0.5%). SweetFramebuffer's
+ * RequestPowerChange calls sweet_backlight_display_power() so screen off
+ * really switches the LCD backlight off.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <libkern/c++/OSSerialize.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+extern "C" int sweet_spmi_init(void);
+extern "C" int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+extern "C" int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value);
+extern "C" void sweet_backlight_display_power(int on);
+
+#define BL_SID          5u
+#define BL_CTRL         0xd800u
+#define BL_SINK         0xd900u
+#define BL_LEVEL_MAX    65536u
+
+class SweetBacklight : public IOService {
+	OSDeclareDefaultStructors(SweetBacklight);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+	void displayPower(bool on);
+private:
+	IOLock   *fLock;
+	bool      fModB;        /* module in use: false = A, true = B */
+	uint16_t  fRawMax;      /* 0x7fff or 0xfff */
+	uint16_t  fRaw;         /* last brightness written or read */
+	uint32_t  fLevel;       /* 0..BL_LEVEL_MAX as published */
+	uint8_t   fSync;        /* sink 0x65 as read at start */
+	bool      fOff;
+	unsigned  fLogged;
+	bool probe(void);
+	bool writeRaw(uint16_t raw);
+	uint16_t levelToRaw(uint32_t level);
+	void publishLevel(uint32_t level);
+	bool applyLevel(uint32_t level);
+};
+OSDefineMetaClassAndStructors(SweetBacklight, IOService);
+
+static SweetBacklight *gSweetBacklight;
+
+static bool
+bl_rd(unsigned addr, uint8_t *v)
+{
+	return sweet_spmi_read(BL_SID, addr, v) == 0;
+}
+
+bool
+SweetBacklight::probe(void)
+{
+	uint8_t en = 0, a_en = 0, b_en = 0, a_w = 0, b_w = 0;
+	uint8_t a_lo = 0, a_hi = 0, b_lo = 0, b_hi = 0, sync = 0;
+	uint8_t src0 = 0, src1 = 0, src2 = 0;
+	bool ok = bl_rd(BL_CTRL + 0x46, &en) &&
+	    bl_rd(BL_SINK + 0x50, &a_en) && bl_rd(BL_SINK + 0x60, &b_en) &&
+	    bl_rd(BL_SINK + 0x52, &a_w) && bl_rd(BL_SINK + 0x62, &b_w) &&
+	    bl_rd(BL_SINK + 0x53, &a_lo) && bl_rd(BL_SINK + 0x54, &a_hi) &&
+	    bl_rd(BL_SINK + 0x63, &b_lo) && bl_rd(BL_SINK + 0x64, &b_hi) &&
+	    bl_rd(BL_SINK + 0x65, &sync) &&
+	    bl_rd(BL_SINK + 0x73, &src0) && bl_rd(BL_SINK + 0x83, &src1) &&
+	    bl_rd(BL_SINK + 0x93, &src2);
+	if (!ok) {
+		IOLog("SWEET BL: WLED read failed\n");
+		return false;
+	}
+	IOLog("SWEET BL: ctrl mod_en=%#x sink A en=%#x w=%u lvl=%#x B en=%#x w=%u lvl=%#x sync=%#x src=%x/%x/%x\n",
+	    en, a_en, a_w, (a_hi << 8) | a_lo, b_en, b_w, (b_hi << 8) | b_lo, sync,
+	    src0, src1, src2);
+	if (a_en & 0x80) {
+		fModB = false;
+	} else if (b_en & 0x80) {
+		fModB = true;
+	} else {
+		fModB = (src0 & 3u) == 1u;
+	}
+	uint8_t w = fModB ? b_w : a_w;
+	fRawMax = (w & 1u) ? 0x7fff : 0xfff;
+	fRaw = (uint16_t)((fModB ? ((b_hi << 8) | b_lo) : ((a_hi << 8) | a_lo)) & fRawMax);
+	fSync = sync;
+	if (!(en & 0x80)) {
+		IOLog("SWEET BL: WLED module is disabled at start; leaving it alone\n");
+		return false;
+	}
+	return true;
+}
+
+bool
+SweetBacklight::writeRaw(uint16_t raw)
+{
+	unsigned lsb = BL_SINK + (fModB ? 0x63 : 0x53);
+	uint8_t base = fSync & ~3u;
+	bool ok = sweet_spmi_write(BL_SID, lsb, raw & 0xff) == 0 &&
+	    sweet_spmi_write(BL_SID, lsb + 1, (raw >> 8) & 0x7f) == 0 &&
+	    sweet_spmi_write(BL_SID, BL_SINK + 0x65, base) == 0 &&
+	    sweet_spmi_write(BL_SID, BL_SINK + 0x65, base | (fModB ? 2u : 1u)) == 0;
+	if (ok) {
+		fRaw = raw;
+	}
+	return ok;
+}
+
+uint16_t
+SweetBacklight::levelToRaw(uint32_t level)
+{
+	if (level > BL_LEVEL_MAX) {
+		level = BL_LEVEL_MAX;
+	}
+	uint64_t raw = ((uint64_t)level * level * fRawMax) / ((uint64_t)BL_LEVEL_MAX * BL_LEVEL_MAX);
+	uint64_t floor = fRawMax / 200 + 1;
+	if (raw < floor) {
+		raw = floor;
+	}
+	return (uint16_t)raw;
+}
+
+void
+SweetBacklight::publishLevel(uint32_t level)
+{
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *bright = OSDictionary::withCapacity(3);
+	OSNumber *mn = OSNumber::withNumber(0ULL, 32);
+	OSNumber *mx = OSNumber::withNumber((unsigned long long)BL_LEVEL_MAX, 32);
+	OSNumber *val = OSNumber::withNumber((unsigned long long)level, 32);
+	if (params && bright && mn && mx && val) {
+		bright->setObject("min", mn);
+		bright->setObject("max", mx);
+		bright->setObject("value", val);
+		params->setObject("brightness", bright);
+		setProperty("IODisplayParameters", params);
+	}
+	OSSafeReleaseNULL(params);
+	OSSafeReleaseNULL(bright);
+	OSSafeReleaseNULL(mn);
+	OSSafeReleaseNULL(mx);
+	OSSafeReleaseNULL(val);
+	fLevel = level;
+}
+
+bool
+SweetBacklight::applyLevel(uint32_t level)
+{
+	IOLockLock(fLock);
+	uint16_t raw = levelToRaw(level);
+	bool ok = fOff ? true : writeRaw(raw);
+	if (fOff) {
+		fRaw = raw;     /* applied when the display comes back on */
+	}
+	IOLockUnlock(fLock);
+	if (ok) {
+		publishLevel(level);
+	}
+	if (fLogged < 64) {
+		IOLog("SWEET BL: level %u -> raw %#x%s%s\n", level, raw,
+		    fOff ? " (display off, deferred)" : "", ok ? "" : " WRITE FAILED");
+	}
+	return ok;
+}
+
+void
+SweetBacklight::displayPower(bool on)
+{
+	IOLockLock(fLock);
+	uint8_t en = 0;
+	bool ok = false;
+	if (on != !fOff && bl_rd(BL_CTRL + 0x46, &en)) {
+		if (on) {
+			ok = writeRaw(fRaw) &&
+			    sweet_spmi_write(BL_SID, BL_CTRL + 0x46, en | 0x80) == 0;
+		} else {
+			ok = sweet_spmi_write(BL_SID, BL_CTRL + 0x46, en & 0x7f) == 0;
+		}
+		if (ok) {
+			fOff = !on;
+		}
+		IOLog("SWEET BL: backlight %s (mod_en was %#x)%s\n", on ? "on" : "off",
+		    en, ok ? "" : " WRITE FAILED");
+	}
+	IOLockUnlock(fLock);
+}
+
+static bool
+bl_number(OSObject *o, uint32_t *out)
+{
+	OSNumber *n = OSDynamicCast(OSNumber, o);
+	if (n) {
+		*out = n->unsigned32BitValue();
+		return true;
+	}
+	OSDictionary *d = OSDynamicCast(OSDictionary, o);
+	if (d && (n = OSDynamicCast(OSNumber, d->getObject("value")))) {
+		*out = n->unsigned32BitValue();
+		return true;
+	}
+	return false;
+}
+
+IOReturn
+SweetBacklight::setProperties(OSObject *properties)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	if (fLogged < 64) {
+		fLogged++;
+		OSSerialize *s = OSSerialize::withCapacity(512);
+		if (s && properties && properties->serialize(s)) {
+			IOLog("SWEET BL: %s setProperties %.300s\n", name, s->text());
+		} else {
+			IOLog("SWEET BL: %s setProperties (unprintable)\n", name);
+		}
+		OSSafeReleaseNULL(s);
+	}
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (!dict) {
+		return kIOReturnBadArgument;
+	}
+	uint32_t level;
+	OSDictionary *params = OSDynamicCast(OSDictionary, dict->getObject("IODisplayParameters"));
+	OSObject *b = params ? params->getObject("brightness") : dict->getObject("brightness");
+	if (b && bl_number(b, &level)) {
+		return applyLevel(level) ? kIOReturnSuccess : kIOReturnIOError;
+	}
+	return kIOReturnSuccess;        /* accepted and logged, not understood */
+}
+
+IOReturn
+SweetBacklight::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOReturn ret = IOService::newUserClient(owningTask, securityID, type, properties, handler);
+	IOLog("SWEET BL: %s newUserClient type %u -> %#x\n", name, (unsigned)type, ret);
+	return ret;
+}
+
+bool
+SweetBacklight::start(IOService *provider)
+{
+	int mode = 0;
+	(void)PE_parse_boot_argn("sweetbl", &mode, sizeof(mode));
+	if (mode < 1 || !IOService::start(provider)) {
+		return false;
+	}
+	fLock = IOLockAlloc();
+	fOff = false;
+	fLogged = 0;
+	if (!fLock || sweet_spmi_init() != 0 || !probe()) {
+		IOLog("SWEET BL: not available\n");
+		return false;
+	}
+	/* Published level from the current raw value: largest level with
+	 * level^2 * max <= raw * LEVEL_MAX^2 (inverse square curve, < 2^48). */
+	uint64_t target = (uint64_t)fRaw * BL_LEVEL_MAX * BL_LEVEL_MAX;
+	uint64_t lo = 0, hi = BL_LEVEL_MAX;
+	while (lo < hi) {
+		uint64_t mid = (lo + hi + 1) / 2;
+		if (mid * mid * fRawMax <= target) {
+			lo = mid;
+		} else {
+			hi = mid - 1;
+		}
+	}
+	setProperty("backlight-control", kOSBooleanTrue);
+	publishLevel((uint32_t)lo);
+	IOLog("SWEET BL: WLED5 module %c, max %#x, boot raw %#x = level %u\n",
+	    fModB ? 'B' : 'A', fRawMax, fRaw, (unsigned)lo);
+	if (mode == 2) {
+		uint16_t boot = fRaw;
+		IOLog("SWEET BL: self-test: ~11%% for 2 s\n");
+		IOLockLock(fLock);
+		bool ok = writeRaw(levelToRaw(BL_LEVEL_MAX / 3));
+		IOLockUnlock(fLock);
+		IOSleep(2000);
+		IOLockLock(fLock);
+		ok = writeRaw(boot) && ok;
+		IOLockUnlock(fLock);
+		IOLog("SWEET BL: self-test %s\n", ok ? "done" : "WRITE FAILED");
+	}
+	gSweetBacklight = this;
+	registerService();
+	return true;
+}
+
+extern "C" void
+sweet_backlight_display_power(int on)
+{
+	SweetBacklight *bl = gSweetBacklight;
+	if (bl) {
+		bl->displayPower(on != 0);
+	}
+}
+#else
+extern "C" void sweet_backlight_display_power(int on);
+extern "C" void
+sweet_backlight_display_power(int on)
+{
+	(void)on;
+}
