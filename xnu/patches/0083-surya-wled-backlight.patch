+static bool
+sp_write_allowed(unsigned sid, unsigned addr)
+{
+	if (sid != 5) {
+		return false;
+	}
+	switch (addr) {
+	case 0xd846:    /* WLED ctrl MOD_EN (bit 7) */
+	case 0xd953:    /* sink MOD_A brightness LSB */
+	case 0xd954:    /* sink MOD_A brightness MSB */
+	case 0xd963:    /* sink MOD_B brightness LSB */
+	case 0xd964:    /* sink MOD_B brightness MSB */
+	case 0xd965:    /* sink MOD_SYNC_BIT */
+		return true;
+	default:
+		return false;
+	}
+}
+
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	if (!sp_ready || !sp_write_allowed(sid, addr)) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid] ||
+	    (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		IOLockUnlock(sp_lock);
+		printf("SWEET SPMI: write sid=%u addr=%#x refused (APID %u not APPS-owned)\n",
+		    sid, addr, apid);
+		return -1;
+	}
+	if (!sp_chn_map[apid]) {
+		sp_chn_map[apid] = ml_io_map(SP_CHN_PA + 0x10000u * apid, 0x1000);
+		if (!sp_chn_map[apid]) {
+			IOLockUnlock(sp_lock);
+			return -1;
+		}
+	}
+	vm_offset_t ch = sp_chn_map[apid];
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x10u) = value;                 /* WDATA0 */
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (addr & 0xffu) << 4;   /* EXT_WRITEL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(ch, 0x08u);
+		if (status & 1u) {
+			IOLockUnlock(sp_lock);
+			if (status & 0x0eu) {
+				printf("SWEET SPMI: write sid=%u addr=%#x status %#x\n",
+				    sid, addr, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET SPMI: write timeout sid=%u addr=%#x APID=%u disabled\n",
+	    sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
