+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * surya: log every exec of an app extension (path contains ".appex"), from
+ * posix_spawn and execve alike: the plain "exec NAME" line (0042) is only
+ * printed on one posix_spawn path. At most 200 lines per boot.
+ */
+static void
+sweet_log_appex(struct image_params *imgp, int error, const char *how)
+{
+	static int sweet_appex_lines;
+	if (imgp == NULL || imgp->ip_strings == NULL || sweet_appex_lines >= 200) {
+		return;
+	}
+	const char *path = imgp->ip_strings + strlen(EXECUTABLE_KEY);
+	if (strnstr(path, ".appex", MAXPATHLEN) == NULL) {
+		return;
+	}
+	sweet_appex_lines++;
+	printf("APPEX %s err %d %.200s\n", how, error, path);
+}
+#endif
