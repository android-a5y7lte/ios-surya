+/* G4d-c: the real HFI bring-up. The GMU must learn where its message table is BEFORE
+ * its firmware starts, so - unlike the minimal G4c boot - this takes the boot itself:
+ * build the SMMU context (so the GMU can reach the buffers), lay the HFI queue table in
+ * the mapped HFI region, write the full register config INCLUDING the HFI/log registers
+ * while the core is held in reset, THEN release it and poll. On success the firmware
+ * reaches 0xbabeface AND the HFI control/version registers become meaningful. Runs
+ * INSTEAD OF the standalone G4c (gated off at sweetgpu>=9) so the core is still in reset
+ * from G4b. Writing HFI_CTRL_INIT and exchanging messages is the next step (G4d-d).
+ * Sequence: HakiOS step_gmu_start / vendor a6xx_gmu_fw_start. */
+static void
+sweet_gpu_g4d_hfi(void)
+{
+	vm_offset_t buffers = 0;
+	vm_offset_t g = ml_io_map(GMU_PA, GMU_SIZE);
+
+	printf("SWEET GPU: G4d-c HFI bring-up (context + message table + configured boot)\n");
+	if (rd(g, GMU_CM3_SYSRESET) != 1) {
+		printf("SWEET GPU: G4d-c core not in reset - needs sweetgpu>=5 (G4b) with G4c gated off; abort\n");
+		return;
+	}
+	if (!gmu_build_context(&buffers)) {
+		printf("SWEET GPU: G4d-c SMMU context did not come up - abort before boot\n");
+		return;
+	}
+
+	/* lay the HFI table + 3 queue descriptors in the mapped HFI region (kernel VA, flushed) */
+	vm_offset_t hfi_kva = buffers + (vm_offset_t)GMU_HFI_PAGE0 * SMMU_GRANULE;
+	volatile struct hfi_table *hfi = (volatile struct hfi_table *)hfi_kva;
+	static const uint8_t prio[HFI_QUEUES] = { 10, 10, 40 };
+	hfi->words = (uint32_t)sizeof(struct hfi_table) / 4u;
+	hfi->first_queue = 6;
+	hfi->queue_words = (uint32_t)sizeof(struct hfi_queue) / 4u;
+	hfi->queues = hfi->active_queues = HFI_QUEUES;
+	for (uint32_t i = 0; i < HFI_QUEUES; i++) {
+		hfi->queue[i].status = 1;
+		hfi->queue[i].start = GMU_IOVA_HFI + HFI_QUEUE_AT(i);
+		hfi->queue[i].type = i | ((uint32_t)prio[i] << 8);
+		hfi->queue[i].words = HFI_QUEUE_WORDS;
+	}
+	to_memory(hfi_kva, (vm_size_t)(GMU_MAP_PAGES - GMU_HFI_PAGE0) * SMMU_GRANULE);
+	printf("SWEET GPU: G4d-c HFI table @ iova 0x%08x: %u queues (q0=0x%08x q1=0x%08x q2=0x%08x)\n",
+	    GMU_IOVA_HFI, HFI_QUEUES, GMU_IOVA_HFI + HFI_QUEUE_AT(0), GMU_IOVA_HFI + HFI_QUEUE_AT(1),
+	    GMU_IOVA_HFI + HFI_QUEUE_AT(2));
+
+	/* wake the GMU's RPMh channel (as G4c) */
+	wr(g, GMU_RSCC_CONTROL_REQ, 2);
+	uint32_t ack = 0;
+	for (int i = 0; i < 200; i++) { ack = rd(g, GMU_RSCC_CONTROL_ACK); if (ack == 2) { break; } IODelay(100); }
+	wr(g, GMU_RSCC_CONTROL_REQ, 0);
+	printf("SWEET GPU: G4d-c rscc_control_ack=0x%08x\n", ack);
+
+	/* full register config INCLUDING HFI/log, core still in reset (HakiOS step_gmu_start order) */
+	wr(g, GMU_CX_FALNEXT_INTF, 1);
+	wr(g, GMU_CX_FAL_INTF, 1);
+	wr(g, GMU_GENERAL_7, 1);
+	wr(g, GMU_CM3_FW_INIT_RESULT, 0);
+	wr(g, GMU_CM3_BOOT_CONFIG, 2);
+	wr(g, GMU_HFI_QTBL_ADDR, GMU_IOVA_HFI);
+	wr(g, GMU_HFI_QTBL_INFO, 1);
+	wr(g, GMU_AHB_FENCE_RANGE_0, (1u << 31) | ((0xau << 2) << 18) | 0x8a0u);
+	wr(g, GMU_CM3_CFG, 0x4052u);
+	vm_offset_t bif = ml_io_map(GBIF_PA, 0x1000);
+	wr(bif, GBIF_HALT, 0);
+	wr(g, GMU_PWR_COL_CP_RESP, 0);
+	wr(g, GMU_HFI_SFR_ADDR, GMU_CHIP);
+	wr(g, GMU_PWR_COL_CP_MSG, GMU_IOVA_LOG | GMU_LOG_PAGES_M1);
+	wr(g, GMU_SYS_BUS_CONFIG, 1);
+	wr(g, GMU_ICACHE_CONFIG, 1);
+	wr(g, GMU_DCACHE_CONFIG, 1);
+	wr(g, GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400u);
+	wr(g, GMU_RPMH_CTRL, rd(g, GMU_RPMH_CTRL) | GMU_RPMH_CTRL_ALL);
+	wr(g, GMU_GMU2HOST_INTR_CLR, 0xffffffffu);
+
+	/* release the core and wait for the firmware to start */
+	printf("SWEET GPU: G4d-c releasing the core (HFI configured); chasing 0xbabeface + HFI status\n");
+	wr(g, GMU_CM3_SYSRESET, 0);
+	uint32_t r = 0;
+	for (int i = 0; i < 5000; i++) {
+		r = rd(g, GMU_CM3_FW_INIT_RESULT);
+		if ((r & GMU_STARTED_MASK) == GMU_STARTED || r == 0xbabefaceu || (r & GMU_FAILED) != 0) { break; }
+		IODelay(100);
+	}
+	uint32_t hfi_status = rd(g, GMU_HFI_CTRL_STATUS);
+	uint32_t hfi_ver    = rd(g, GMU_HFI_VERSION_INFO);
+	uint32_t intr       = rd(g, GMU_GMU2HOST_INTR_INFO);
+	printf("SWEET GPU: G4d-c cm3_fw_init_result=0x%08x hfi_ctrl_status=0x%08x hfi_version=0x%08x gmu2host_intr=0x%08x\n",
+	    r, hfi_status, hfi_ver, intr);
+	if ((r & GMU_STARTED_MASK) == GMU_STARTED || r == 0xbabefaceu) {
+		printf("SWEET GPU: G4d-c *** GMU BOOTED WITH HFI CONFIGURED *** (fw 0x%08x, hfi version 0x%08x). Next: G4d-d (CTRL_INIT + send a message).\n",
+		    r, hfi_ver);
+	} else {
+		printf("SWEET GPU: G4d-c GMU did not start with HFI (0x%08x) - recoverable, reboot. Compare against the G4c minimal boot.\n", r);
 	}
 }
 
