diff --git a/iokit/Kernel/arm/SweetGPU.cpp b/iokit/Kernel/arm/SweetGPU.cpp
index 9e5de18..c8b62db 100644
--- a/iokit/Kernel/arm/SweetGPU.cpp
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -19,6 +19,7 @@
  *   sweetgpu>=9  G4d-c: context + HFI message table + configured GMU boot (patch 0114).
  *               (>=9 runs G4d-c INSTEAD of the minimal G4c boot - HFI must be set pre-boot.)
  *   sweetgpu>=10 +G4d-d: ring HFI_CTRL_INIT and watch the GMU bring HFI up (patch 0115).
+ *   sweetgpu>=11 +G4d-e: send GMU_INIT on q0, poll q1 for the first ack (patch 0116).
  *
  * G2 touches only the CX ("always-on") half of the GPU block: the GMU, the bus
  * interface and the GPU SMMU. It does NOT power the GX (3D core) rail: on this
@@ -718,7 +719,7 @@ sweet_gpu_g4d_setup(void)
  * from G4b. Writing HFI_CTRL_INIT and exchanging messages is the next step (G4d-d).
  * Sequence: HakiOS step_gmu_start / vendor a6xx_gmu_fw_start. */
 static void
-sweet_gpu_g4d_hfi(bool do_ctrl_init)
+sweet_gpu_g4d_hfi(int stage) /* 0=G4d-c, 1=+G4d-d, 2=+G4d-e */
 {
 	vm_offset_t buffers = 0;
 	vm_offset_t g = ml_io_map(GMU_PA, GMU_SIZE);
@@ -809,7 +810,7 @@ sweet_gpu_g4d_hfi(bool do_ctrl_init)
 	 * GMU2HOST_INTR_INFO too. Vendor a6xx_hfi.c calls this "hfi start"; HakiOS reaches
 	 * the same state through a brief waitlet after step_gmu_start. Clear the host-side
 	 * interrupt latch first so a fresh event shows plainly. */
-	if (!do_ctrl_init) {
+	if (stage < 1) {
 		return;
 	}
 	printf("SWEET GPU: G4d-d ring HFI_CTRL_INIT=1 and watch the GMU answer\n");
@@ -827,10 +828,75 @@ sweet_gpu_g4d_hfi(bool do_ctrl_init)
 	printf("SWEET GPU: G4d-d hfi_ctrl_status=0x%08x hfi_version=0x%08x gmu2host_intr=0x%08x fw=0x%08x\n",
 	    s2, v2, in2, fw2);
 	if (s2 & 1u) {
-		printf("SWEET GPU: G4d-d *** HFI IS ALIVE *** (version 0x%08x, intr 0x%08x). Next: look at queue 1 (gmu->host) and send a F2H message.\n",
-		    v2, in2);
+		printf("SWEET GPU: G4d-d *** HFI IS ALIVE *** (version 0x%08x, intr 0x%08x).\n", v2, in2);
 	} else {
-		printf("SWEET GPU: G4d-d HFI did not come up after CTRL_INIT - recoverable, reboot. Likely: table layout or queue descriptors. Compare queue addresses vs what HFI firmware expects.\n");
+		printf("SWEET GPU: G4d-d HFI not alive yet (status 0x%08x). Vendor flow sends GMU_INIT next; that is G4d-e.\n", s2);
+	}
+
+	/* G4d-e: send the first H2F message - GMU_INIT - on queue 0 and watch for the GMU's
+	 * ack on queue 1. Vendor adreno_a6xx_hfi.c a6xx_hfi_send_gmu_init. The GMU reads the
+	 * message queue directly through its SMMU context (set up in G4d-b), so the CPU must
+	 * write via an uncached view (ml_io_map_wcomb on the HFI buffer phys range) so each
+	 * store lands in DRAM at once and reads see what the GMU wrote without manual cache
+	 * invalidation. GMU_INIT packet = 5 dwords: hdr(id=0x01 size=5 type=0) + seg_id=0 +
+	 * dbg_buf_addr=0 + dbg_buf_size=0 + boot_state=0 (cold). */
+	if (stage < 2) {
+		return;
+	}
+	printf("SWEET GPU: G4d-e send GMU_INIT on q0 and poll q1 for the GMU's ack\n");
+	uint64_t hfi_phys = kvtophys(hfi_kva);
+	vm_offset_t hfi_unc = ml_io_map_wcomb((vm_offset_t)hfi_phys,
+	    (vm_size_t)(GMU_MAP_PAGES - GMU_HFI_PAGE0) * SMMU_GRANULE);
+	if (hfi_unc == 0) {
+		printf("SWEET GPU: G4d-e ml_io_map_wcomb failed - abort\n");
+		return;
+	}
+	volatile struct hfi_table *hfi_u = (volatile struct hfi_table *)hfi_unc;
+	volatile uint32_t *q0_data = (volatile uint32_t *)(hfi_unc + HFI_QUEUE_AT(0));
+	volatile uint32_t *q1_data = (volatile uint32_t *)(hfi_unc + HFI_QUEUE_AT(1));
+	uint32_t w0 = hfi_u->queue[0].write;
+	uint32_t hdr = 0x01u | (5u << 8) | (0u << 16); /* id=GMU_INIT|size=5|type=CMD */
+	q0_data[w0 + 0u] = hdr;
+	q0_data[w0 + 1u] = 0u;             /* seg_id */
+	q0_data[w0 + 2u] = 0u;             /* dbg_buf_addr */
+	q0_data[w0 + 3u] = 0u;             /* dbg_buf_size */
+	q0_data[w0 + 4u] = 0u;             /* boot_state = cold */
+	hfi_u->queue[0].write = w0 + 5u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET GPU: G4d-e wrote GMU_INIT hdr=0x%08x at q0[w=%u], new write=%u\n",
+	    hdr, w0, w0 + 5u);
+
+	/* ring the GMU: bit 0 of HOST2GMU_INTR_SET = "message waiting for you" */
+	wr(g, GMU_GMU2HOST_INTR_CLR, 0xffffffffu);  /* clear any stale latch */
+	wr(g, GMU_HOST2GMU_INTR_SET, 1u);
+
+	/* poll ~100 ms for either the GMU interrupt latch or q1 write index to advance */
+	uint32_t intr_info = 0;
+	uint32_t q1_w = 0;
+	for (int i = 0; i < 1000; i++) {
+		intr_info = rd(g, GMU_GMU2HOST_INTR_INFO);
+		q1_w = hfi_u->queue[1].write;
+		if (intr_info != 0u || q1_w != 0u) { break; }
+		IODelay(100);
+	}
+	uint32_t s3  = rd(g, GMU_HFI_CTRL_STATUS);
+	uint32_t v3  = rd(g, GMU_HFI_VERSION_INFO);
+	uint32_t q1_r = hfi_u->queue[1].read;
+	printf("SWEET GPU: G4d-e intr_info=0x%08x hfi_status=0x%08x hfi_version=0x%08x q1[r=%u w=%u]\n",
+	    intr_info, s3, v3, q1_r, q1_w);
+	if (q1_w != 0u) {
+		uint32_t ack_hdr  = q1_data[0];
+		uint32_t ack_id   = ack_hdr & 0xffu;
+		uint32_t ack_size = (ack_hdr >> 8) & 0xffu;
+		uint32_t ack_type = (ack_hdr >> 16) & 0xfu;
+		printf("SWEET GPU: G4d-e q1 ack hdr=0x%08x (id=0x%02x size=%u type=%u) dw1=0x%08x dw2=0x%08x dw3=0x%08x\n",
+		    ack_hdr, ack_id, ack_size, ack_type, q1_data[1], q1_data[2], q1_data[3]);
+	}
+	if ((s3 & 1u) != 0u || q1_w != 0u) {
+		printf("SWEET GPU: G4d-e *** HFI HANDSHAKE SUCCEEDED *** (status 0x%08x, q1_write=%u). The kernel is talking to the GMU. Next: perf/bw tables, then GX rail up.\n",
+		    s3, q1_w);
+	} else {
+		printf("SWEET GPU: G4d-e GMU did not answer within ~100 ms. CTRL_STATUS 0x%08x unchanged. Next test: mesa-style page-aligned queue layout (q0@+0x1000, q1@+0x2000, q2@+0x3000), or different GMU_INIT payload size.\n", s3);
 	}
 }
 
@@ -891,7 +957,9 @@ SweetGPU::start(IOService *provider)
 		sweet_gpu_g4d_setup();          /* standalone context test */
 	}
 	if (enabled >= 9) {
-		sweet_gpu_g4d_hfi(enabled >= 10); /* context + HFI table + boot; >=10 also rings CTRL_INIT */
+		int stage = enabled - 9; /* 9->0 G4d-c, 10->1 +G4d-d, 11->2 +G4d-e */
+		if (stage > 2) { stage = 2; }
+		sweet_gpu_g4d_hfi(stage);
 	}
 	return true;
 }
