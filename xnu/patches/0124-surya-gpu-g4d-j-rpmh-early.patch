+/* Mainline-aligned a618 RPMH init - factored out so it can run EARLY (before the GMU
+ * firmware boots) at stage >=8, or late (after boot, at the wrong time) at stage ==7.
+ * All writes; no reads of PDC_SEQ (hypervisor-guarded). Values and layout from the
+ * generated a6xx*.xml.h; see a6xx_gmu_rpmh_init() for the authoritative sequence. */
+static void
+gmu_full_rpmh_init(vm_offset_t g, vm_offset_t p, vm_offset_t pseq)
+{
+	static const uint32_t rscc_seq_a618[5] = {
+	    0xa7a506a0u, 0xa1e6a6e7u, 0xa2e081e1u, 0xe9a982e2u, 0x0020e8a8u
+	};
+	static const uint32_t pdc_seq_a618[5] = {
+	    0xfebea1e1u, 0xa5a4a3a2u, 0x8382a6e0u, 0xbce3e284u, 0x002081fcu
+	};
+	wr(g, RSCC_GPU_RSC_STATUS0_DRV0, 1u << 24);
+	wr(g, RSCC_PDC_SLAVE_ID_DRV0, 1u);
+	wr(g, RSCC_HIDDEN_TCS_CMD0_DATA + 0u, 0u);
+	wr(g, RSCC_HIDDEN_TCS_CMD0_ADDR + 0u, 0u);
+	wr(g, RSCC_HIDDEN_TCS_CMD0_DATA + 4u * 2u, 0u);
+	wr(g, RSCC_HIDDEN_TCS_CMD0_ADDR + 4u * 2u, 0u);
+	wr(g, RSCC_HIDDEN_TCS_CMD0_DATA + 4u * 4u, 0x80000000u);
+	wr(g, RSCC_HIDDEN_TCS_CMD0_ADDR + 4u * 4u, 0u);
+	wr(g, RSCC_OVERRIDE_START_ADDR, 0u);
+	wr(g, RSCC_PDC_SEQ_START_ADDR, 0x4520u);
+	wr(g, RSCC_PDC_MATCH_VALUE_LO, 0x4510u);
+	wr(g, RSCC_PDC_MATCH_VALUE_HI, 0x4514u);
+	for (uint32_t i = 0; i < 5u; i++) { wr(g, RSCC_SEQ_MEM_0_DRV0 + 4u * i, rscc_seq_a618[i]); }
+	for (uint32_t i = 0; i < 5u; i++) { wr(pseq, 4u * i, pdc_seq_a618[i]); }
+	wr(p, PDC_GPU_TCS1_CMD_ENABLE_BANK, 7u);
+	wr(p, PDC_GPU_TCS1_CMD_WAIT_FOR_CMPL_BANK, 0u);
+	wr(p, PDC_GPU_TCS1_CONTROL, 0u);
+	wr(p, PDC_GPU_TCS1_CMD0_MSGID + 4u * 0u, 0x10108u);
+	wr(p, PDC_GPU_TCS1_CMD0_ADDR  + 4u * 0u, 0x30010u);
+	wr(p, PDC_GPU_TCS1_CMD0_DATA  + 4u * 0u, 1u);
+	wr(p, PDC_GPU_TCS1_CMD0_MSGID + 4u * 1u, 0x10108u);
+	wr(p, PDC_GPU_TCS1_CMD0_ADDR  + 4u * 1u, 0x30000u);
+	wr(p, PDC_GPU_TCS1_CMD0_DATA  + 4u * 1u, 0u);
+	wr(p, PDC_GPU_TCS1_CMD0_MSGID + 4u * 2u, 0x10108u);
+	wr(p, PDC_GPU_TCS1_CMD0_ADDR  + 4u * 2u, A618_PDC_ADDRESS_OFFSET);
+	wr(p, PDC_GPU_TCS1_CMD0_DATA  + 4u * 2u, 0u);
+	wr(p, PDC_GPU_TCS3_CMD_ENABLE_BANK, 7u);
+	wr(p, PDC_GPU_TCS3_CMD_WAIT_FOR_CMPL_BANK, 0u);
+	wr(p, PDC_GPU_TCS3_CONTROL, 0u);
+	wr(p, PDC_GPU_TCS3_CMD0_MSGID + 4u * 0u, 0x10108u);
+	wr(p, PDC_GPU_TCS3_CMD0_ADDR  + 4u * 0u, 0x30010u);
+	wr(p, PDC_GPU_TCS3_CMD0_DATA  + 4u * 0u, 2u);
+	wr(p, PDC_GPU_TCS3_CMD0_MSGID + 4u * 1u, 0x10108u);
+	wr(p, PDC_GPU_TCS3_CMD0_ADDR  + 4u * 1u, 0x30000u);
+	wr(p, PDC_GPU_TCS3_CMD0_DATA  + 4u * 1u, 0x2u);
+	wr(p, PDC_GPU_TCS3_CMD0_MSGID + 4u * 2u, 0x10108u);
+	wr(p, PDC_GPU_TCS3_CMD0_ADDR  + 4u * 2u, A618_PDC_ADDRESS_OFFSET);
+	wr(p, PDC_GPU_TCS3_CMD0_DATA  + 4u * 2u, 0x3u);
+	wr(p, PDC_GPU_SEQ_START_ADDR, 0u);
+	wr(p, PDC_GPU_ENABLE, 0x80000001u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
