-			printf("SWEET GPU: G4d-i FULL a618 RPMH init (RSCC@gmu+0x23000, PDC_CFG@0xb290000, PDC_SEQ@0xb490000)\n");
-
-			/* RSCC side: these go to gmu+0x23000..+0x23600, using regular wr() */
-			wr(g, RSCC_GPU_RSC_STATUS0_DRV0, 1u << 24);           /* disable SDE clock gating */
-			wr(g, RSCC_PDC_SLAVE_ID_DRV0, 1u);
-			wr(g, RSCC_HIDDEN_TCS_CMD0_DATA + 0u, 0u);            /* CMD0 data (DATA and ADDR are */
-			wr(g, RSCC_HIDDEN_TCS_CMD0_ADDR + 0u, 0u);            /* interleaved, one word each,  */
-			wr(g, RSCC_HIDDEN_TCS_CMD0_DATA + 4u * 2u, 0u);       /* so + 2 words = next CMD)      */
-			wr(g, RSCC_HIDDEN_TCS_CMD0_ADDR + 4u * 2u, 0u);
-			wr(g, RSCC_HIDDEN_TCS_CMD0_DATA + 4u * 4u, 0x80000000u); /* a618 (not a740/a722) */
-			wr(g, RSCC_HIDDEN_TCS_CMD0_ADDR + 4u * 4u, 0u);
-			wr(g, RSCC_OVERRIDE_START_ADDR, 0u);
-			wr(g, RSCC_PDC_SEQ_START_ADDR, 0x4520u);
-			wr(g, RSCC_PDC_MATCH_VALUE_LO, 0x4510u);
-			wr(g, RSCC_PDC_MATCH_VALUE_HI, 0x4514u);
-			for (uint32_t i = 0; i < 5u; i++) {
-				wr(g, RSCC_SEQ_MEM_0_DRV0 + 4u * i, rscc_seq_a618[i]);
-			}
-
