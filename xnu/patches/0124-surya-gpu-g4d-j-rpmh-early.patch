 {
@@ -808,6 +865,19 @@ sweet_gpu_g4d_hfi(int stage) /* 0=G4d-c, 1=+G4d-d, 2=+G4d-e */
 	    GMU_IOVA_HFI, HFI_QUEUES, GMU_IOVA_HFI + HFI_QUEUE_AT(0), GMU_IOVA_HFI + HFI_QUEUE_AT(1),
 	    GMU_IOVA_HFI + HFI_QUEUE_AT(2));
 
+	/* G4d-j (stage >= 8): run the FULL RPMH init BEFORE waking RSCC. Mainline order is
+	 * rpmh_init -> rpmh_start -> fw_start -> hfi_start. Running rpmh_init AFTER fw_start
+	 * (as stage 7 does) leaves the GMU firmware's HFI init stuck in 0xfe forever, because
+	 * the firmware decides its RPMH state at boot and does not re-check. Early init gives
+	 * the firmware a working RPMH channel on its first boot instead. */
+	if (stage >= 8) {
+		vm_offset_t p_early = ml_io_map(GMU_PDC_PA, GMU_PDC_SIZE);
+		vm_offset_t pseq_early = ml_io_map(GMU_PDC_SEQ_PA, GMU_PDC_SEQ_SIZE);
+		printf("SWEET GPU: G4d-j EARLY FULL a618 RPMH init (BEFORE RSCC wake / reset release)\n");
+		gmu_full_rpmh_init(g, p_early, pseq_early);
+		printf("SWEET GPU: G4d-j wrote full RPMH init early; next: RSCC wake + release reset\n");
+	}
+
 	/* wake the GMU's RPMh channel (as G4c) */
 	wr(g, GMU_RSCC_CONTROL_REQ, 2);
 	uint32_t ack = 0;
@@ -888,74 +958,16 @@ sweet_gpu_g4d_hfi(int stage) /* 0=G4d-c, 1=+G4d-d, 2=+G4d-e */
 		printf("SWEET GPU: G4d-g PDC enable: before start_addr=0x%08x enable=0x%08x -> after start_addr=0x%08x enable=0x%08x\n",
 		    sa0, en0, sa1, en1);
 
