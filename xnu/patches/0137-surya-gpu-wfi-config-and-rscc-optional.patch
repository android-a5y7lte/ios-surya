+ * handshake - which is what CTRL_STATUS 0xfe looks like from our side. Register
+ * number is KGSL 0x1f802 less the 0x1a800 KGSL/mainline offset, confirmed against
+ * SYSRESET 0x1f800/0x5000, BOOT_CONFIG 0x1f801/0x5001, FW_INIT_RESULT 0x1f81c/0x501c
+ * and CM3_CFG 0x1f82d/0x502d. */
+#define GMU_CX_GMU_WFI_CONFIG           GMU_WORD(0x5002u)
