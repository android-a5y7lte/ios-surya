 	printf("SWEET GPU: G4d-ctx tables@phys 0x%llx buffers@phys 0x%llx ttbr0=0x%llx iova 0x%08x..0x%08x\n",
 	    (uint64_t)kvtophys((vm_offset_t)l1), (uint64_t)kvtophys(buffers), ttbr0,
 	    GMU_IOVA_DUMMY, GMU_IOVA_LOG + 0xfffu);
@@ -828,7 +834,7 @@ gmu_build_context(vm_offset_t *buffers_out)
 	smmu_wr(cb, SMMU_CB_MAIR0, SMMU_MAIR0_CFG);
 	smmu_wr(cb, SMMU_CB_MAIR1, 0);
 	smmu_wr(cb, SMMU_CB_FSR, SMMU_FSR_FAULTS);
-	smmu_wr(cb, SMMU_CB_TLBIASID, GMU_CTX);
+	smmu_wr(cb, SMMU_CB_TLBIASID, GMU_ASID);
 	smmu_wr(cb, SMMU_CB_TLBSYNC, 1);
