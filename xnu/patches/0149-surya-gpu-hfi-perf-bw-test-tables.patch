+/* KGSL's H2F ids; 0146 established that ours were wrong. INIT 0 and FW_VER 1 are sent
+ * inline in G4d-e, these three finish a6xx_gmu_hfi_start. */
+#define H2F_MSG_BW_VOTE_TBL_ID  0x03u
+#define H2F_MSG_PERF_TBL_ID     0x04u
+
+/*
+ * Send one message on q0 and wait for its ack on q1, with the queue discipline 0146 and 0147
+ * established: write EXACTLY n dwords, advance write by exactly n, ring, then drain q1 by
+ * setting read to write. Returns false and prints the reason on a timeout or an error word.
+ */
+static bool
+sweet_hfi_cmd(vm_offset_t g, volatile struct hfi_table *hfi_u, volatile uint32_t *q0_data,
+    volatile uint32_t *q1_data, const char *lbl, const char *name, const uint32_t *msg, uint32_t n)
+{
+	uint32_t w = hfi_u->queue[0].write;
+	uint32_t prev = hfi_u->queue[1].write;
+	for (uint32_t i = 0; i < n; i++) {
+		q0_data[w + i] = msg[i];
+	}
+	hfi_u->queue[0].write = w + n;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(g, GMU_GMU2HOST_INTR_CLR, 0xffffffffu);
+	wr(g, GMU_HOST2GMU_INTR_SET, 1u);
+	uint32_t qw = prev, intr = 0;
+	for (int i = 0; i < 2000; i++) {
+		intr = rd(g, GMU_GMU2HOST_INTR_INFO);
+		qw = hfi_u->queue[1].write;
+		if (qw != prev) {
+			break;
+		}
+		IODelay(100);
+	}
+	if (qw == prev) {
+		printf("SWEET GPU: %s %s (%u dw at q0[w=%u]): NO ACK within ~200 ms, intr=0x%08x hfi_status=0x%08x\n",
+		    lbl, name, n, w, intr, rd(g, GMU_HFI_CTRL_STATUS));
+		return false;
+	}
+	uint32_t a0 = q1_data[prev], err = q1_data[prev + 2u];
+	hfi_u->queue[1].read = qw;       /* drain, or the GMU answers once and stops */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET GPU: %s %s acked: hdr=0x%08x (id=0x%02x size=%u type=%u) err=0x%08x q1[%u->%u] intr=0x%08x\n",
+	    lbl, name, a0, a0 & 0xffu, (a0 >> 8) & 0xffu, (a0 >> 16) & 0xfu, err, prev, qw, intr);
+	if (err != 0u) {
+		printf("SWEET GPU: %s %s REJECTED with error 0x%08x\n", lbl, name, err);
+		return false;
+	}
+	if ((intr & (1u << 23)) != 0u) {
+		printf("SWEET GPU: %s %s acked but CM3_FAULT is set (intr 0x%08x)\n", lbl, name, intr);
+		return false;
+	}
+	return true;
 }
 
