+/*
+ * gx_gfx3d rate_max per vdd_gx corner with that corner's RPMh VLVL, and KGSL's
+ * setup_volt_dependency_tbl. arc_vote_tbl does NOT need an exact VLVL match: it takes the
+ * first primary ARC index whose level COVERS the request, which matters here because
+ * surya's gfx.lvl reports 0 16 64 128 ... and has no 48 for the 180 MHz corner - that
+ * level resolves to index 2 (VLVL 64) and is correct.
+ */
+static const struct { uint16_t mhz, vlvl; } gx_corners[] = {
+	{ 180, 48 }, { 267, 64 }, { 355, 128 }, { 430, 192 },
+	{ 565, 256 }, { 650, 320 }, { 800, 384 }, { 825, 416 },
+};
+#define ARC_VOTE(pri, sec, vlvl) ((((vlvl) & 0xffffu) << 16) | (((sec) & 0xffu) << 8) | ((pri) & 0xffu))
+#define MAX_CX_LEVELS       4u
+#define PERF_TBL_DW         (3u + 2u * GPU_MAX_LEVELS + 2u * MAX_CX_LEVELS)
+#define BW_TBL_DW           (6u + 6u + 2u * 6u + 8u + GPU_MAX_LEVELS * 8u)
+
+static uint32_t gx_votes[GPU_MAX_LEVELS], gx_khz[GPU_MAX_LEVELS];
+static uint32_t cx_votes[MAX_CX_LEVELS], cx_khz[MAX_CX_LEVELS];
+static unsigned gx_levels;
+
+static unsigned
+gx_vlvl(unsigned mhz)
+{
+	if (mhz == 0u) {
+		return 0u;                  /* KGSL hardcodes VLVL 0 for the 0 Hz level */
+	}
+	for (unsigned i = 0; i < sizeof(gx_corners) / sizeof(gx_corners[0]); i++) {
+		if (mhz <= gx_corners[i].mhz) {
+			return gx_corners[i].vlvl;
+		}
+	}
+	return 0xffffu;
+}
+
+static bool
+arc_vote_tbl(const char *what, const uint16_t *pri, unsigned npri, const uint16_t *sec,
+    unsigned nsec, const unsigned *vlvl, unsigned n, uint32_t *votes)
+{
+	for (unsigned i = 0; i < n; i++) {
+		unsigned k = 0, j = 0;
+		while (k < npri && pri[k] < vlvl[i]) {
+			k++;
+		}
+		if (k == npri) {
+			printf("SWEET GPU: G5-b %s level %u: VLVL %u is above all %u ARC levels\n",
+			    what, i, vlvl[i], npri);
+			return false;
+		}
+		for (j = 0; j < nsec; j++) {
+			if (sec[j] >= pri[k] || j + 1u == nsec) {
+				break;
+			}
+		}
+		votes[i] = ARC_VOTE(k, (j == nsec) ? 0u : j, pri[k]);
+	}
+	return true;
+}
