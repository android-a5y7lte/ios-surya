+static vm_offset_t gmu_tables_kva;      /* L1/L2/L3a/L3b of the GMU context; the CP shares L1/L2 */
+
 static bool
 gmu_build_context(vm_offset_t *buffers_out)
 {
@@ -812,6 +814,7 @@ gmu_build_context(vm_offset_t *buffers_out)
 		    (unsigned long long)kvtophys(buffers), (unsigned long long)bufsz);
 	}
 	*buffers_out = buffers;
+	gmu_tables_kva = tables;
 
 	uint64_t *l1  = (uint64_t *)(tables + 0x0000u);
 	uint64_t *l2  = (uint64_t *)(tables + 0x1000u);
@@ -1350,6 +1353,367 @@ sweet_gpu_g5b_dcvs_read(void)
